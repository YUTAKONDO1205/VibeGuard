---
/**
 * The layout for everything that describes something you can actually get:
 * /, /install, /rules, /news, /privacy, and the 404.
 *
 * The counterpart is ResearchLayout, and the difference between the two files
 * is the entire mechanism protecting the site from promising unshipped work.
 * This one imports the header, the CTA and the version badge; that one imports
 * none of them. The separation is checkable — `grep -rl CtaButton src/layouts/`
 * returns this file and not the other — which is why it is a file split rather
 * than a documented convention.
 */
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/bands.css';
import '../styles/components.css';

import SiteHeader from '../components/SiteHeader.astro';
import FooterWithCta from '../components/FooterWithCta.astro';
import meta from '../data/meta.json';
import { canonicalUrl } from '../shared/canonical.ts';

interface Props {
  title: string;
  description: string;
  /** Set false on /install, which is where the CTA already points. */
  header?: boolean;
}
const { title, description, header = true } = Astro.props;
const canonical = canonicalUrl(Astro.site, Astro.url.pathname);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/*
      Link-unfurl metadata. This site will be met far more often as a pasted
      URL in a chat, an issue or a link aggregator than as a search result, and
      a bare URL there gets a fraction of the clicks a titled card does. That is
      the same conversion the whole site is measured on.

      It costs nothing the CSP cares about: these are meta tags, read by a
      crawler out of the HTML. The page loads nothing extra, so `default-src
      'self'` is untouched and the no-third-party-resources claim on /privacy
      stays exactly as true as it was.

      og:url and og:image are emitted only when a domain is known, because both
      require absolute URLs. Guessing one before the domain exists would publish
      a link to somewhere that does not answer — worse than omitting the tag,
      which simply makes the crawler fall back to the URL it already fetched.
    */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="VibeGuard" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>

  <body>
    <a class="vg-skip" href="#main">Skip to content</a>
    {header && <SiteHeader />}
    <main id="main">
      <slot />
    </main>
    <FooterWithCta version={meta.toolVersion} />
  </body>
</html>

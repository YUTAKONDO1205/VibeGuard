---
/**
 * The 404.
 *
 * A heading, one sentence, one link home. Nothing else, and the omissions are
 * the design:
 *
 *   · No search box. Searching needs an index and client-side JavaScript, and
 *     this site ships neither. A box that cannot search is worse than no box.
 *   · No sitemap. The footer already carries one on every page, this one
 *     included.
 *   · No call to action. A visitor who mistyped a URL is not in a moment to be
 *     sold to, and putting the button on the error page would weaken the claim
 *     it earns everywhere else: that it appears where it is useful (§3.7.2).
 *
 * Cloudflare's static-asset handler serves this file for an unmatched path, so
 * it is a page like any other and gets the same layout, header and footer.
 */
import ProductLayout from '../layouts/ProductLayout.astro';
---

<ProductLayout title="Not found — VibeGuard" description="That page does not exist.">
  <section class="vg-band vg-band--base" aria-labelledby="notfound-h">
    <div class="vg-band__inner">
      <h1 class="vg-h1" id="notfound-h">Not found</h1>
      <p class="vg-lead">That page does not exist.</p>
      <p><a href="/">Go to the front page</a></p>
    </div>
  </section>
</ProductLayout>

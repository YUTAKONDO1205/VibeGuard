---
/**
 * The front page.
 *
 * Six bands under the header, each on its own surface token, in the order fixed
 * by §5.2: hero (code) / pitch and CTA (base) / categories (tint) / triptych
 * (code) / screenshots (base) / news (news). The alternation is not decoration.
 * It is how a long scrolling page tells a reader that one subject has ended and
 * another has begun, on a site with no illustrations to do that job.
 *
 * WHAT THIS PAGE DELIBERATELY DOES NOT DO
 *
 * It does not link to a store. Every route out to a distribution channel goes
 * through /install and then /go/*, so that the four channels are compared in
 * one place and counted in one place (§1.2, §2.2). A single direct link here
 * would be the one that is never counted.
 *
 * It does not carry a hand-written number. Rule counts come from rules.json,
 * releases from releases.json, the version from meta.json via the layout. The
 * only integers in this file are the four rows the news band shows.
 *
 * It does not explain itself in prose above the fold. The hero is one real
 * finding — the argument being that a tool that finds things should be judged
 * on a thing it found, not on a sentence about finding things.
 */
import ProductLayout from '../layouts/ProductLayout.astro';
import CtaButton from '../components/CtaButton.astro';
import Finding from '../components/Finding.astro';
import IconGrid from '../components/IconGrid.astro';
import Triptych from '../components/Triptych.astro';
import NewsList from '../components/NewsList.astro';

import rulesData from '../data/rules.json';
import releasesData from '../data/releases.json';
import triptychData from '../data/triptych.json';

import type { ImageMetadata } from 'astro';
import type { FindingView } from '../components/Finding.astro';

/**
 * WHICH FINDING THE HERO SHOWS, AND WHY IT IS RESOLVED HERE.
 *
 * §5.9 of the design document says the hero shows the same sample the triptych
 * then works through, so that a reader going down the page meets a finding and
 * then watches it get answered. That is the default below: the first card's
 * finding, which is generated by scripts/site-export-triptych.mjs from a real
 * scan.
 *
 * §3.1.2 argues for a different one — the DEBUG bypass in
 * samples/vulnerable/auth_bypass.py — on the grounds that it is the problem
 * this product is named after and is readable in any language. If a generator
 * ever writes site/src/data/hero.json, that finding wins here automatically.
 *
 * The optional read is `import.meta.glob` rather than a plain import for one
 * reason: a plain import of a file no script produces is a build error, and a
 * front page that cannot build because an optional refinement is absent is not
 * a refinement. The glob resolves to an empty object when the file is not
 * there, and to the finding when it is.
 *
 * The file, when it exists, is a finding in the shape @vibeguard/findings-schema
 * emits, plus an optional `sourceFile` naming the repository fixture it was
 * scanned from.
 */
const heroOverride =
  Object.values(
    import.meta.glob<{ default: FindingView & { sourceFile?: string } }>('../data/hero.json', {
      eager: true,
    }),
  )[0]?.default ?? null;

const heroCard = triptychData.cards[0];
const hero: FindingView = heroOverride ?? heroCard.finding;

/**
 * Where the code came from — and the check that the caption cannot lie about it.
 *
 * A finding published without its provenance reads as somebody's real breach on
 * display, which is not what a security tool's front page should look like. So
 * the caption names a file, and the name is read out of the data rather than
 * typed: a caption naming one file above a finding from another would be worse
 * than no caption at all.
 *
 * The assertion is on the shape of the path rather than on one filename,
 * because the point being protected is not "this specific fixture" but "some
 * fixture in this repository that is vulnerable on purpose". A path outside
 * samples/ would mean the hero is quoting real code, which is the thing that
 * must never happen quietly.
 */
const heroSource = (heroOverride?.sourceFile ?? heroOverride?.filePath ?? heroCard.sourceFile)
  .replace(/^\.\//, '');
if (!heroSource.startsWith('samples/')) {
  throw new Error(
    `The hero finding comes from ${heroSource}, which is not under samples/. The caption ` +
      `calls it a fixture that is vulnerable on purpose; only samples/ holds those, and a ` +
      `finding shown without honest provenance reads as a disclosure of somebody's real code.`,
  );
}

const totals = rulesData.totals;

/**
 * Screenshots are optional at build time, and their absence must not be papered
 * over.
 *
 * Neither capture exists in the repository today. Two ways to handle that were
 * available and only one of them is honest: draw a convincing mock-up of the
 * extension, or say plainly that there is no picture. A mock-up on a page whose
 * entire argument is "this is the real output" would poison the argument, and
 * the reader has no way to tell which of the two images on the page was real.
 *
 * `import.meta.glob` rather than a static import, because a static import of a
 * missing file is a build error, and this band has to build either way. When
 * the files land in src/assets/screens/, they are picked up with no code change
 * — and whoever adds them must replace the alt text below with what is actually
 * on the screen, because an alt text describing a screenshot nobody has taken
 * is a description of something that does not exist.
 */
const screenModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/screens/*.{png,webp}',
  { eager: true },
);

const screens = new Map<string, ImageMetadata>(
  Object.entries(screenModules).map(([path, mod]) => [
    path.replace(/^.*\//, '').replace(/\.[^.]+$/, ''),
    mod.default,
  ]),
);

const SHOTS = [
  {
    key: 'vscode',
    /**
     * The larger of the two. §5.10 keeps the model site's asymmetry and gives
     * it a meaning it did not have there: size ranks the channels, and VS Code
     * is the one /install marks "Start here".
     */
    size: 'lg',
    alt: 'The VS Code extension: findings underlined in the editor after a save, with the VibeGuard Findings view open beside the file.',
    caption: 'VS Code — findings appear inline when you save the file.',
    missing: 'There is no screenshot of the VS Code extension on this page.',
  },
  {
    key: 'chrome',
    size: 'sm',
    alt: 'The Chrome extension: the Side Panel listing the findings extracted from the code blocks on the page being read.',
    caption: 'Chrome — scan the code on a page you are reading.',
    missing: 'There is no screenshot of the Chrome extension on this page.',
  },
];
---

<ProductLayout
  title="VibeGuard — a security scanner for AI-generated code"
  description="VibeGuard finds the security bugs that AI-generated code tends to hide: skipped login checks, hard-coded secrets, unsafe deserialization, swallowed exceptions. It runs in VS Code, in Chrome, and in CI."
>
  {/* Band 2 — the hero. The CTA is not in here; see the band below. */}
  <section class="vg-band vg-band--code vg-hero" aria-labelledby="hero-h">
    <div class="vg-band__inner">
      <h1 class="vg-h1" id="hero-h">VibeGuard — a security scanner for AI-generated code</h1>
      <Finding finding={hero} variant="hero" />
      <p class="vg-hero__caption">
        Real output. The code is <code>{heroSource}</code> in this repository — a fixture that is
        vulnerable on purpose.
      </p>
    </div>
  </section>

  {/*
    Band 3 — one line and the button.

    The CTA sits here rather than in the hero for a measured reason: its fill
    reads at 7.90 against this surface and 2.25 against the code surface above,
    so on the hero it would be a button nobody with low vision can find. The
    sentence is README.md's own second sentence, not a new one written for the
    site; a home page that describes the product differently from its README is
    a second description to keep true.
  */}
  <section class="vg-band vg-band--base vg-pitch">
    <div class="vg-band__inner">
      <p class="vg-pitch__line">
        It catches the bugs that "looks fine, ships fine" code tends to hide: missing input checks,
        hard-coded passwords, skipped login checks, exceptions silently caught, and so on.
      </p>
      <CtaButton />
    </div>
  </section>

  {/* Band 4 — the eight categories. The page's main explanation. */}
  <section class="vg-band vg-band--tint" aria-labelledby="cats-h">
    <div class="vg-band__inner">
      <h2 class="vg-h2" id="cats-h"><span class="vg-h2__deco" aria-hidden="true">//</span>What it finds</h2>
      <IconGrid />
    </div>
  </section>

  {/* Band 5 — Before, the finding, After. */}
  <section class="vg-band vg-band--code" aria-labelledby="triptych-h">
    <div class="vg-band__inner">
      <h2 class="vg-h2" id="triptych-h">
        <span class="vg-h2__deco" aria-hidden="true">//</span>What a finding looks like
      </h2>

      <Triptych />

      {/*
        The counts are read out of rules.json, and the sentence is built so that
        it stays grammatical whatever they become. It says the unflattering half
        out loud: most rules have no fixer, and almost none of the fixes are
        safe to take unread. That is the honest shape of the feature, and a
        reader who finds it out later instead of here stops trusting the rest of
        the page.
      */}
      <p class="vg-triptych__note">
        Fixers exist for {totals.fixers} of the {totals.rules} rules — {totals.needsReviewFixers}
        {' '}labelled needs-review, {totals.safeFixers} labelled safe. VibeGuard offers an edit only
        for those, only when you pass <code>--fix</code>, and an edit it cannot show to be correct is
        not made: the finding stays instead. Every other rule is reported and left alone.{' '}
        <a href="/rules">See which rules have a fixer</a>.
      </p>
    </div>
  </section>

  {/* Band 6 — the two product screens, or an honest note that they are absent. */}
  <section class="vg-band vg-band--base" aria-labelledby="shots-h">
    <div class="vg-band__inner">
      <h2 class="vg-h2" id="shots-h">
        <span class="vg-h2__deco" aria-hidden="true">//</span>On your screen
      </h2>

      <div class="vg-shots">
        {
          SHOTS.map((shot) => {
            const image = screens.get(shot.key);
            return (
              <figure class:list={['vg-shot', `vg-shot--${shot.size}`]}>
                {image ? (
                  <img
                    class="vg-shot__img"
                    src={image.src}
                    width={image.width}
                    height={image.height}
                    alt={shot.alt}
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  /* Unstyled on purpose. Anything that looks like a frame here
                     starts to look like the product. */
                  <p class="vg-shot__missing">
                    {shot.missing} The rest of this page shows output the scanner produced; a drawing
                    of the interface would be the only thing on it that nobody can check, so there is
                    no drawing.
                  </p>
                )}
                <figcaption class="vg-shot__caption">{shot.caption}</figcaption>
              </figure>
            );
          })
        }
      </div>
    </div>
  </section>

  {/* Band 7 — News. Four rows, newest tagged. */}
  <section class="vg-band vg-band--news" aria-labelledby="news-h">
    <div class="vg-band__inner">
      <h2 class="vg-h2" id="news-h"><span class="vg-h2__deco" aria-hidden="true">//</span>News</h2>
      <NewsList releases={releasesData.releases} limit={4} markNewest={true} />
      <p class="vg-news__more"><a href="/news">All releases</a></p>
    </div>
  </section>
</ProductLayout>

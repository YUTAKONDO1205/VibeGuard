          "message": { "text": "role comparison — this one is on the labelled FALSE POSITIVE site" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/routes/billing.ts", "uriBaseId": "%SRCROOT%" },
                "region": { "startLine": 32, "startColumn": 41, "endLine": 32, "endColumn": 70 }
              }
            }
          ],
          "partialFingerprints": { "matchBasedId/v1": "aa1b2c3d4e5f60718293a4b5c6d7e8f9_0" },

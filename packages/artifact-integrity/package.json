{
  "name": "@vibeguard/artifact-integrity",
  "version": "0.3.6",
  "private": true,
  "type": "module",
  "description": "Artefact security verifier: hardening set, W+X, secret residue and build-path residue in a finished ELF",
  "license": "MIT",
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./bundle": {
      "types": "./src/bundle.d.mts",
      "default": "./src/bundle.mjs"
    },
    "./cross-examine": {
      "types": "./src/cross-examine.d.mts",
      "default": "./src/cross-examine.mjs"
    }
  },
  "files": [
    "src",
    "bin",
    "README.md"
  ],
  "scripts": {
    "test": "node test/_run.mjs",
    "verify": "node bin/vg-artefact-verify.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
